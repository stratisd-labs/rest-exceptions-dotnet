<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>RestExceptions</PackageId>
    <Title>RestExceptions</Title>
    <Version>10.1.0</Version>

    <Authors>Stratis-Dermanoutsos</Authors>

    <Copyright>Copyright © Stratis Dermanoutsos 2026</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>

    <PackageProjectUrl>https://github.com/stratisd-labs/rest-exceptions-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stratisd-labs/rest-exceptions-dotnet</RepositoryUrl>

    <Description>Extensible Web API middleware that maps all exceptions to standardized RFC 9457 (Problem Details, formerly RFC 7807) HTTP responses.</Description>
    <PackageTags>open-source http oss rest errors csharp dotnet exceptions problem-details rfc9457 rfc7807</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>* Added IRestExceptionMapper, to map additional exception types, registered through AddRestExceptions(options => options.AddMapper&lt;T&gt;()).
* Added RestExceptionFactory, to create a RestException from an HttpStatusCode.
* Exceptions mapped to 5xx are now logged, since .NET 10 no longer logs exceptions handled by an IExceptionHandler.
* Fixed a crash when a RestException's extensions contained a "method" or "requestId" key.
* Fixed the default message of FailedDependencyRestException.
* Included XML documentation in the package.
* Breaking: InvalidOperationException is now mapped to 500 Internal Server Error, instead of 405 Method Not Allowed.
* Breaking: StringExtensions.ToKebabCase is now internal.
    </PackageReleaseNotes>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every public member is documented yet -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--  Required to have the AddProblemDetails extension  -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/"/>
    <None Include="../../README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>
</Project>
